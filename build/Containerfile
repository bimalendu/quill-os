# Build environment for Quill OS images and RPMs.
# Runs kiwi-ng the way the Fedora Asahi Remix project does: inside a
# privileged Fedora aarch64 container.
ARG FEDORA_RELEASE=44
FROM registry.fedoraproject.org/fedora:${FEDORA_RELEASE}

RUN dnf -y install \
        kiwi-cli \
        kiwi-systemdeps \
        git \
        rpm-build \
        rpmdevtools \
        jq \
        zip \
        curl \
        createrepo_c \
        rpm-sign \
        gnupg2 \
        rpmlint \
        redhat-rpm-config \
        systemd-rpm-macros \
        librsvg2-tools \
        ImageMagick \
        gawk \
        flatpak \
        cmake \
        gcc-c++ \
        qt6-qtbase-devel \
        qt6-qtdeclarative-devel \
        qt6-qtsvg \
        kf6-kirigami \
        kf6-qqc2-desktop-style \
        breeze-icon-theme \
        dejavu-sans-fonts \
        dejavu-sans-mono-fonts \
        polkit \
        desktop-file-utils \
    && dnf clean all

COPY build-rpms.sh /usr/local/bin/build-rpms

WORKDIR /work
