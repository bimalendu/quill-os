<image>
	<profiles>
		<profile name="Common" description="Common packages"/>
		<!-- Quill: the Apple Silicon (Asahi) specific packages, split out of Common so
		     that the generic aarch64 VM image does not get them. -->
		<profile name="AsahiPlatform" description="Apple Silicon (Asahi) platform packages"/>
	</profiles>
	<packages type="image" patternType="plusRecommended" profiles="Common">
		<namedCollection name="core"/>
		<namedCollection name="standard"/>
		<namedCollection name="hardware-support"/>
		<package name="NetworkManager-wifi"/>
		<package name="chrony"/>
		<package name="glibc-all-langpacks"/>
		<!-- Quill: snapshots before and after package transactions, quill-rollback -->
		<package name="quill-snapshots"/>
		<ignore name="dracut-config-rescue"/>
		<ignore name="generic-release*"/>
		<ignore name="generic-logos*"/>
		<!-- Quill: replaced by quill-release, quill-logos and quill-backgrounds-kde,
		     which provide the same capabilities. ignore matches package names only. -->
		<ignore name="fedora-asahi-remix-release*"/>
		<ignore name="fedora-release*"/>
		<ignore name="fedora-logos*"/>
		<!-- Quill: no phone-home or misrouted reports. ABRT's libreport-fedora files
		     crash reports on Fedora's Bugzilla, and NetworkManager's Fedora
		     connectivity check requests fedoraproject.org on every connection. -->
		<ignore name="abrt*"/>
		<ignore name="gnome-abrt"/>
		<!-- libreport-filesystem stays: mdadm requires it. It only owns directories. -->
		<ignore name="libreport-fedora"/>
		<!-- satyr and python3-libreport stay: initial-setup (Minimal) -> anaconda-tui ->
		     python3-meh -> python3-libreport -> satyr. Only ABRT pulls them otherwise. -->
		<ignore name="NetworkManager-config-connectivity-fedora"/>
		<!-- pulled in as Recommends: via toolbox -> podman -> containers-common-extra -->
		<ignore name="qemu-user-static"/>
		<!-- ignore *-firmware packages which are unlikely to be used -->
		<ignore name="amd-gpu-firmware"/>
		<ignore name="amd-ucode-firmware"/>
		<ignore name="intel-audio-firmware"/>
		<ignore name="intel-gpu-firmware"/>
		<ignore name="iwlwifi-mvm-firmware"/>
		<ignore name="nvidia-gpu-firmware"/>
		<ignore name="qcom-firmware"/>
	</packages>
	<packages type="image" patternType="plusRecommended" profiles="AsahiPlatform">
		<package name="alsa-ucm-asahi"/>
		<package name="asahi-platform-metapackage"/>
		<package name="asahi-repos"/>
		<package name="fedora-asahi-remix-scripts"/>
		<package name="tiny-dfr"/>
	</packages>
</image>
