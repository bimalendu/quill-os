<image>
	<profiles>
		<profile name="DesktopCommon" description="Common desktop packages">
			<requires profile="Common"/>
		</profile>
		<profile name="KDE-Desktop" description="KDE Plasma Desktop">
			<requires profile="DesktopCommon"/>
		</profile>
	</profiles>
	<packages type="image" patternType="plusRecommended" profiles="DesktopCommon">
		<namedCollection name="firefox"/>
		<namedCollection name="fonts"/>
		<namedCollection name="input-methods"/>
		<namedCollection name="multimedia"/>
		<namedCollection name="printing"/>
		<namedCollection name="x86-emulation"/>
		<package name="aajohan-comfortaa-fonts"/>
		<package name="mediawriter"/>
		<package name="mesa-dri-drivers"/>
		<package name="mesa-vulkan-drivers"/>
		<package name="plymouth-system-theme"/>
		<ignore name="@dial-up"/>
		<ignore name="@guest-desktop-agents"/>
		<!-- Quill: ibus-m17n-1.4.39-1.fc44 is in updates metadata but missing from every mirror (2026-10-30). Remove once Fedora fixes the repo. -->
		<ignore name="ibus-m17n"/>
		<ignore name="xorg-x11-server-Xorg"/>
	</packages>
	<packages type="bootstrap" patternType="plusRecommended" profiles="KDE-Desktop">
		<package name="fedora-release-kde"/>
	</packages>
	<packages type="image" patternType="plusRecommended" profiles="KDE-Desktop">
		<namedCollection name="kde-desktop-environment"/>
		<namedCollection name="kde-media"/>
		<package name="fuse"/>
		<package name="kde-l10n"/>
		<!-- Quill: kde-apps and kde-pim collections are dropped; keep these core apps -->
		<package name="kcalc"/>
		<package name="okular"/>
		<package name="skanpage"/>
		<!-- Quill: trimmed from the default image. The kde-desktop-environment
		     environment installs the kde-pim, kde-apps and libreoffice groups by
		     default, and kiwi's <ignore> becomes dnf exclude=NAME, which
		     matches package names, not @groups. So list the packages. Nothing
		     outside the PIM stack depends on it (checked with repoquery). -->
		<ignore name="elisa-player"/>
		<ignore name="kde-connect"/>
		<ignore name="libreoffice*"/>
		<ignore name="akonadi*"/>
		<ignore name="kdepim*"/>
		<ignore name="pim-*"/>
		<ignore name="kmail*"/>
		<ignore name="kontact*"/>
		<ignore name="korganizer"/>
		<ignore name="kaddressbook"/>
		<ignore name="akregator"/>
		<ignore name="kleopatra"/>
		<ignore name="keditbookmarks"/>
		<ignore name="kmahjongg"/>
		<ignore name="kmines"/>
		<ignore name="kmouth"/>
		<ignore name="kpat"/>
		<ignore name="krdc"/>
		<ignore name="krusader"/>
		<ignore name="ktorrent"/>
		<ignore name="neochat"/>
		<ignore name="qrca"/>
		<ignore name="@admin-tools"/>
		<ignore name="initial-setup"/> <!-- redundant with plasma-setup -->
		<ignore name="gnome-disk-utility"/>
		<ignore name="system-config-printer"/>
	</packages>
</image>
